{
  "name": "esa-explorer",
  "displayName": "esa Explorer",
  "description": "esa.ioの記事をVisual Studio Code上で一覧・閲覧・編集する拡張機能",
  "version": "0.1.0",
  "publisher": "local",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/LevelCapCoJapanTools/vscode_esa_explorer.git"
  },
  "main": "./out/extension.js",
  "categories": [
    "Other"
  ],
  "keywords": [
    "esa",
    "markdown",
    "documentation",
    "knowledge-base"
  ],
  "engines": {
    "vscode": "^1.105.0"
  },
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": true
    },
    "virtualWorkspaces": {
      "supported": true
    }
  },
  "activationEvents": [
    "onView:esaExplorer.posts",
    "onFileSystem:esa",
    "onFileSystem:esa-draft",
    "onCommand:esaExplorer.configure",
    "onCommand:esaExplorer.openPost",
    "onCommand:esaExplorer.createDraft",
    "onCommand:esaExplorer.createDraftHere"
  ],
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "esaExplorer",
          "title": "esa",
          "icon": "media/esa-explorer.svg"
        }
      ]
    },
    "views": {
      "esaExplorer": [
        {
          "id": "esaExplorer.posts",
          "name": "記事管理"
        }
      ]
    },
    "commands": [
      {
        "command": "esaExplorer.configure",
        "title": "接続設定",
        "category": "esa Explorer"
      },
      {
        "command": "esaExplorer.setToken",
        "title": "Personal Access Tokenを設定",
        "category": "esa Explorer"
      },
      {
        "command": "esaExplorer.clearCredentials",
        "title": "認証情報を削除",
        "category": "esa Explorer"
      },
      {
        "command": "esaExplorer.refreshPosts",
        "title": "更新",
        "category": "esa Explorer",
        "icon": "$(refresh)"
      },
      {
        "command": "esaExplorer.openPost",
        "title": "Markdownで開く",
        "category": "esa Explorer"
      },
      {
        "command": "esaExplorer.openInBrowser",
        "title": "esa.ioで開く",
        "category": "esa Explorer"
      },
      {
        "command": "esaExplorer.showOutput",
        "title": "出力を表示",
        "category": "esa Explorer"
      },
      {
        "command": "esaExplorer.createDraft",
        "title": "新規記事",
        "category": "esa Explorer"
      },
      {
        "command": "esaExplorer.createDraftHere",
        "title": "新規記事（ここに作成）",
        "category": "esa Explorer"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "esaExplorer.refreshPosts",
          "when": "view == esaExplorer.posts",
          "group": "navigation"
        },
        {
          "command": "esaExplorer.createDraft",
          "when": "view == esaExplorer.posts",
          "group": "navigation"
        },
        {
          "command": "esaExplorer.configure",
          "when": "view == esaExplorer.posts",
          "group": "navigation"
        }
      ],
      "view/item/context": [
        {
          "command": "esaExplorer.openPost",
          "when": "viewItem == esaPost",
          "group": "navigation@1"
        },
        {
          "command": "esaExplorer.openInBrowser",
          "when": "viewItem == esaPost",
          "group": "navigation@2"
        },
        {
          "command": "esaExplorer.createDraftHere",
          "when": "viewItem == esaCategory",
          "group": "inline"
        }
      ]
    },
    "configuration": {
      "title": "esa Explorer",
      "properties": {
        "esaExplorer.teamName": {
          "type": "string",
          "default": "",
          "scope": "window",
          "description": "接続するesa.ioチームのチーム名を指定します。URL全体ではなく、https://TEAM.esa.io の TEAM 部分を入力してください。"
        }
      }
    },
    "viewsWelcome": [
      {
        "view": "esaExplorer.posts",
        "contents": "esa.ioへの接続設定が必要です。\n\n[接続設定を開始](command:esaExplorer.configure)",
        "when": "!esaExplorer.isConfigured"
      }
    ]
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "typecheck": "tsc --noEmit -p ./",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "npm run compile && vscode-test",
    "check": "npm run typecheck && npm run lint && npm run format:check",
    "security": "npm audit",
    "verify": "npm run check && npm test && npm run security",
    "package:vsix": "node -e \"require('node:fs').mkdirSync('dist', { recursive: true })\" && vsce package --out dist/esa-explorer.vsix"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "@types/vscode": "^1.105.0",
    "@vscode/test-cli": "^0.0.10",
    "@vscode/test-electron": "^2.4.0",
    "@typescript-eslint/eslint-plugin": "^8.0.0",
    "@typescript-eslint/parser": "^8.0.0",
    "eslint": "^9.0.0",
    "prettier": "^3.0.0",
    "typescript": "^5.4.0",
    "@vscode/vsce": "^3.0.0"
  },
  "overrides": {
    "glob@>=9.0.0 <=14.0.1": "^14.0.2",
    "minimatch@>=7.0.0 <11.0.1": "^11.0.1",
    "serialize-javascript@<7.1.3": "^7.1.3"
  }
}
